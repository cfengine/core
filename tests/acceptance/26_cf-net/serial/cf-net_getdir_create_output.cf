body common control
{
  inputs => { "../../default.sub.cf", "../../run_with_server.cf.sub" };
  bundlesequence => { default("$(this.promise_filename)") };
}

bundle agent init
{
  files:
    # Only a file, so no subdirectory creation creates the output directory
    "$(G.testdir)/remote/top.txt"
      create => "true",
      content => "top";

  methods:
    "any" usebundle => dcs_fini("$(G.testdir)/out");
    "any" usebundle => generate_key;
    "any" usebundle => trust_key;

    "any"
      usebundle => start_server(
        "$(this.promise_dirname)/serverd_admit_localhost_15000.cf.srv"
      );
}

bundle agent test
{
  meta:
    "description"
      string => "getdir creates the output directory if it does not exist";

    "test_skip_needs_work"
      string => "windows",
      meta => { "ENT-10254" };

  commands:
    "$(sys.cf_net)"
      args => " -H 127.0.0.1:15000 getdir -o $(G.testdir)/out $(G.testdir)/remote";
}

bundle agent check
{
  methods:
    "check"
      usebundle => dcs_check_diff(
        "$(G.testdir)/out/remote/top.txt",
        "$(G.testdir)/remote/top.txt",
        "$(this.promise_filename)"
      );
}

bundle agent destroy
{
  methods:
    "any"
      usebundle => stop_server(
        "$(this.promise_dirname)/serverd_admit_localhost_15000.cf.srv"
      );
}
