#######################################################
#
# Test users promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor run_users
{
  users:
    # a user that doesn't exist, so that the promise is kept without changing
    # anything, whether or not the test runs as root. An existing user with
    # policy "present" is unlocked if its password is locked, which happens
    # to root on some systems.
    "cf-reactor-test-no-such-user"
      policy => "absent",
      classes => then_outcome("users");
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => { run_users, record_then_outcome("$(events_file)", "users") };
}
