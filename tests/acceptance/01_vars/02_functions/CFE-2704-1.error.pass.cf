# This is an .error.pass.cf test, because mergedata() is given data
# which is not a container on purpose and logs an error, the test checks
# that the agent does not crash.

body common control
{
  inputs => { "../../default.sub.cf" };
  bundlesequence => { default("$(this.promise_filename)") };
}

bundle agent test
{
  meta:
    "description" -> { "CFE-2704" }
      string => "Test that attempting to merge incompatible data does not segfault. Variant 1.";

  vars:
    "data" data => '{"env":"test"}';
    "node" data => mergedata("[]", "data[env]");
}

bundle agent check
{
  methods:
    "Pass if we made it this far"
      usebundle => dcs_pass($(this.promise_filename));
}
