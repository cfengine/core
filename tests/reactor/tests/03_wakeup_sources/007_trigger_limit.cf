#######################################################
#
# Test the limit on how often a watcher runs its bundles
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when modified(file)
{
  file_modified => "$(file)";
  interval => 1;
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => modified("$(test)"),
      then => record_event("$(events_file)", "$(test) was modified");
}
