#######################################################
#
# Test that every reactor bundle is evaluated
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "init", "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor init
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");
}

bundle reactor test
{
  events:
    "$(init.promise_name)"
      when => deleted("$(init.test)"),
      then => record_event("$(init.events_file)", "$(init.test) was deleted");
}
