#######################################################
#
# Test what is a modification for a file_modified event
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when modified(file)
{
  file_modified => "$(file)";
}

bundle reactor test
{
  vars:
    "file_a" string => getenv("FILE_A", 999);
    "file_b" string => getenv("FILE_B", 999);
    "file_c" string => getenv("FILE_C", 999);
    "file_d" string => getenv("FILE_D", 999);
    "file_e" string => getenv("FILE_E", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    # a regular file, written to
    "$(promise_name)_A"
      when => modified("$(file_a)"),
      then => record_event("$(events_file)", "A modified");

    # a regular file, touched
    "$(promise_name)_B"
      when => modified("$(file_b)"),
      then => record_event("$(events_file)", "B modified");

    # a symlink
    "$(promise_name)_C"
      when => modified("$(file_c)"),
      then => record_event("$(events_file)", "C modified");

    # a directory
    "$(promise_name)_D"
      when => modified("$(file_d)"),
      then => record_event("$(events_file)", "D modified");

    # a file created after the start
    "$(promise_name)_E"
      when => modified("$(file_e)"),
      then => record_event("$(events_file)", "E modified");
}
