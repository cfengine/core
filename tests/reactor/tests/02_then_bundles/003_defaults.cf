#######################################################
#
# Test defaults promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor run_defaults(events_file, msg)
{
  defaults:
    "msg"
      string => "default message",
      if_match_regex => "";

  methods:
    "any" usebundle => record_event("$(events_file)", "defaults $(msg)");
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => run_defaults("$(events_file)", "");
}
