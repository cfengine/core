#######################################################
#
# Test vars promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor run_vars(events_file, value_file)
{
  vars:
    # execresult() is a cached function: the cache must not outlive an event
    "value" string => execresult("/bin/cat $(value_file)", "noshell");

  methods:
    "any" usebundle => record_event("$(events_file)", "vars $(value)");
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "value_file" string => getenv("VALUE_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => run_vars("$(events_file)", "$(value_file)");
}
