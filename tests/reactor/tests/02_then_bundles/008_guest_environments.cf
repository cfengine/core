#######################################################
#
# Test guest_environments promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor run_guest_environments
{
  guest_environments:
    # the guest that the "test" hypervisor of libvirt (test:///default) runs.
    # Without libvirt, guest_environments promises are kept without doing
    # anything, and without defining the classes of their outcome, so there's
    # no classes body here: the test looks at the log instead.
    "test"
      environment_type => "test",
      environment_host => "$(sys.host)",
      environment_state => "running";
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => "run_guest_environments";
}
