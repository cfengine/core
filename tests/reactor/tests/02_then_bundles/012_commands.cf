#######################################################
#
# Test commands promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

body contain in_shell
{
  useshell => "useshell";
}

bundle reactor run_commands(events_file, output, module_file)
{
  commands:
    "echo ran >> '$(output)'"
      contain => in_shell,
      classes => then_outcome("commands");

    # defines reactor_test.value from the output of the command
    "/bin/cat $(module_file)" module => "true";

  reports:
    "$(with): commands module value $(reactor_test.value)"
      with => strftime("localtime", "%Y-%m-%d %H:%M:%S", now()),
      report_to_file => "$(events_file)";
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "output" string => getenv("OUTPUT_FILE", 999);
    "module_file" string => getenv("MODULE_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => {
        run_commands("$(events_file)", "$(output)", "$(module_file)"),
        record_then_outcome("$(events_file)", "commands"),
      };
}
