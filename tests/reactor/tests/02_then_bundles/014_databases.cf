#######################################################
#
# Test databases promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

# No database server is running, so the promise can't be kept, but it is
# evaluated
body database_server no_server
{
  db_server_owner => "nobody";
  db_server_password => "";
  db_server_host => "localhost";
  db_server_type => "postgres";
  db_server_connection_db => "postgres";
}

bundle reactor run_databases
{
  databases:
    "reactor_test"
      database_operation => "create",
      database_type => "sql",
      database_server => no_server;
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => "run_databases";
}
