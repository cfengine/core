#######################################################
#
# Test that the ifelapsed of 0 that cf-reactor uses by default can be
# overridden by the promises of the "then" bundles
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

body action if_elapsed(minutes)
{
  ifelapsed => "$(minutes)";
}

bundle agent record(file_default, file_ifelapsed, msg)
{
  reports:
    # first, so that it is skipped or not by the time the other one is made
    "$(msg)"
      report_to_file => "$(file_ifelapsed)",
      action => if_elapsed("60");

    "$(msg)" report_to_file => "$(file_default)";
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file_default" string => getenv("EVENTS_FILE_DEFAULT", 999);
    "events_file_ifelapsed" string => getenv("EVENTS_FILE_IFELAPSED", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => record(
        "$(events_file_default)",
        "$(events_file_ifelapsed)",
        "$(test) was deleted"
      );
}
