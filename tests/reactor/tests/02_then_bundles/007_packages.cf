#######################################################
#
# Test packages promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

# Queries the installed packages on every evaluation (query_installed_ifelapsed
# of 0), so the package removed between events is installed again
body package_module reactor_test
{
  query_installed_ifelapsed => "0";
  query_updates_ifelapsed => "0";
  default_options => { "$(test.installed)" };
}

bundle reactor run_packages
{
  packages:
    "reactor_test_pkg"
      policy => "present",
      package_module => reactor_test,
      classes => then_outcome("packages");
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "installed" string => getenv("INSTALLED_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => {
        "run_packages", record_then_outcome("$(events_file)", "packages")
      };
}
