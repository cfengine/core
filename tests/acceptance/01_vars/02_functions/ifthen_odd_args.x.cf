######################################################
#
# Test that ifthen() with an odd number of arguments is an error
#
#####################################################
body common control
{
  inputs => { "../../default.sub.cf" };
  bundlesequence => { default("$(this.promise_filename)") };
  version => "1.0";
}

#######################################################
bundle agent test
{
  meta:
    "description" -> { "ENT-14719" }
      string => "Test that ifthen() with an odd number of arguments is an error";

  vars:
    "x" string => ifthen("any", "value", "fallthrough");
}

#######################################################
bundle agent check
{
  reports:
    "$(this.promise_filename) FAIL";
}
