#######################################################
#
# Test duplicate event promises
#
# The two promises are identical, so cf-reactor only registers one watcher
# for them and the "then" bundle is run only once per event
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => record_event("$(events_file)", "$(test) was deleted");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => record_event("$(events_file)", "$(test) was deleted");
}
