#######################################################
#
# Test classes promises in reactor bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  classes:
    "reactor_test_defined_class" expression => "any";

  events:
    reactor_test_defined_class::
      "$(promise_name)"
        when => deleted("$(test)"),
        then => record_event("$(events_file)", "$(test) was deleted");

    reactor_test_undefined_class::
      "$(promise_name)_2"
        when => deleted("$(test)"),
        then => record_event(
          "$(events_file)", "$(test) was deleted (undefined class)"
        );
}
