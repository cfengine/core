#######################################################
#
# Test methods promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor run_methods(events_file, value_file)
{
  methods:
    "any"
      usebundle => record_event("$(events_file)", "methods $(value)"),
      classes => then_outcome("methods");

  vars:
    "value" string => readfile("$(value_file)");
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "value_file" string => getenv("VALUE_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => {
        run_methods("$(events_file)", "$(value_file)"),
        record_then_outcome("$(events_file)", "methods"),
      };
}
