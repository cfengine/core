#######################################################
#
# Test classes promises in a "then" bundle
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
}

bundle reactor run_classes(events_file, marker)
{
  classes:
    # returnszero() is a cached function: the cache must not outlive an event
    "marker_exists"
      expression => returnszero("test -f '$(marker)'", "useshell");

  methods:
    marker_exists::
      "any"
        usebundle => record_event("$(events_file)", "classes marker exists");

    !marker_exists::
      "any"
        usebundle => record_event("$(events_file)", "classes marker missing");
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "marker" string => getenv("MARKER_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => run_classes("$(events_file)", "$(marker)");
}
