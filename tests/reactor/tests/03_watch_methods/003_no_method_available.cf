#######################################################
#
# Test that without poll, an unavailable method makes the promise not kept
#
#######################################################
body common control
{
  inputs => { "../../lib.cf" };
  bundlesequence => { "test" };
  version => "1.0";
}

body when deleted(file)
{
  file_deleted => "$(file)";
  watch_methods => { "usn", "rdcw" };
}

bundle reactor test
{
  vars:
    "test" string => getenv("TESTFILE", 999);
    "events_file" string => getenv("EVENTS_FILE", 999);
    "promise_name" string => basename("$(this.promise_filename)", ".cf");

  events:
    "$(promise_name)"
      when => deleted("$(test)"),
      then => record_event("$(events_file)", "$(test) was deleted");
}
